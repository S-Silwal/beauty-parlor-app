generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================== USER & AUTH ======================
model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  phone         String? @unique
  password_hash String
  avatar        String?
  role          Role    @default(CUSTOMER)
  is_verified   Boolean @default(false)
  mfa_enabled   Boolean @default(false)

  // Notification Preferences
  email_notifications Boolean @default(true)
  sms_notifications   Boolean @default(true)

  failedLoginAttempts Int       @default(0)
  accountLockedUntil  DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  notificationLogs NotificationLog[]
  notifications    Notification[]
  appointments     Appointment[]
  reviews          Review[]
  transactions     Transaction[]
  refreshTokens    RefreshToken[]
  resetTokens      PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  otpCodes         OtpCode[]
  changeRequests   AppointmentChangeRequest[]
  staffProfile     Staff?
  auditLogs        AdminAuditLog[]

  @@map("users")
}

// ====================== AUTH MODELS ======================
model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model OtpCode {
  id         String   @id @default(uuid())
  user_id    String
  code       String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

// ====================== SERVICES & STAFF ======================
model Service {
  id          String          @id @default(uuid())
  name        String          @unique
  category    ServiceCategory
  description String?
  duration    Int
  price       Decimal
  image       String?
  is_popular  Boolean         @default(false)
  isActive    Boolean         @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  appointments Appointment[]
  reviews      Review[]
  changeRequests AppointmentChangeRequest[]

  @@map("services")
}

model Staff {
  id             String  @id @default(uuid())
  name           String
  phone          String?
  email          String?
  specialization String?
  bio            String?
  avatar         String?
  isActive       Boolean @default(true)

  // The User account that logs in as this staff member (role=STAFF), if
  // they have portal access at all — a Staff row can exist purely as a
  // bookable name with no login. Nullable + unique: at most one login per
  // staff record. See StaffService.resolveCallerStaffId() for how this is
  // used to scope a logged-in staff user to only their own appointments.
  user_id String? @unique
  user    User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  availability StaffAvailability[]
  changeRequests AppointmentChangeRequest[]

  @@map("staff")
}

// ====================== APPOINTMENT ======================
model Appointment {
  id               String            @id @default(uuid())
  user_id          String
  service_id       String
  staff_id         String?
  notificationLogs NotificationLog[]

  appointment_date DateTime
  duration         Int
  total_price      Decimal

  status              AppointmentStatus @default(PENDING)
  payment_status      PaymentStatus     @default(PENDING)
  notes               String?
  cancellation_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [service_id], references: [id], onDelete: Restrict)
  staff       Staff?       @relation(fields: [staff_id], references: [id], onDelete: SetNull)
  transaction Transaction?
  reviews     Review[]
  changeRequests AppointmentChangeRequest[]

  @@index([user_id])
  @@index([service_id])
  @@index([staff_id])
  @@index([appointment_date])
  @@index([status])
  @@index([payment_status])
  @@map("appointments")
}

// ====================== CHANGE REQUESTS ======================
// A customer-submitted request to edit (date/time/staff/service) or cancel
// an upcoming appointment. The underlying Appointment is never touched
// until an admin approves the request — see ChangeRequestService.
model AppointmentChangeRequest {
  id             String @id @default(uuid())
  appointment_id String
  user_id        String

  type   ChangeRequestType
  status ChangeRequestStatus @default(PENDING)

  // Only meaningful for EDIT requests — whichever of these the customer
  // actually changed; the rest fall back to the appointment's current
  // values when the request is approved.
  requested_date       DateTime?
  requested_staff_id   String?
  requested_service_id String?

  customer_note  String? // optional note from the customer (mainly for CANCEL)
  decline_reason String? // admin's reason, or the auto-decline explanation

  created_at  DateTime  @default(now())
  resolved_at DateTime?

  appointment      Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  requestedStaff   Staff?      @relation(fields: [requested_staff_id], references: [id], onDelete: SetNull)
  requestedService Service?    @relation(fields: [requested_service_id], references: [id], onDelete: SetNull)

  @@index([appointment_id])
  @@index([status])
  @@map("appointment_change_requests")
}

// ====================== REVIEWS & TRANSACTIONS ======================
model Review {
  id             String @id @default(uuid())
  user_id        String
  service_id     String
  appointment_id String @unique

  rating     Int
  comment    String?
  created_at DateTime @default(now())

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [service_id], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Transaction {
  id             String        @id @default(uuid())
  appointment_id String        @unique
  user_id        String
  amount         Decimal
  payment_method String?
  status         PaymentStatus @default(PENDING)
  transaction_id String?
  created_at     DateTime      @default(now())

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)

  @@map("transactions")
}

// ====================== NEW MODELS ======================
model GalleryImage {
  id          String   @id @default(uuid())
  url         String
  alt_text    String?
  category    String? // "interior", "before-after", "service", etc.
  is_active   Boolean  @default(true)
  uploaded_by String?
  created_at  DateTime @default(now())

  @@map("gallery_images")
}

model StaffAvailability {
  id         String   @id @default(uuid())
  staff_id   String
  date       DateTime
  start_time String // "09:00"
  end_time   String // "17:00"
  is_blocked Boolean  @default(false)
  reason     String?

  staff Staff @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@unique([staff_id, date, start_time])
  @@map("staff_availability")
}

// Records who changed what on the admin-mutable entities that matter most
// (appointment status/payment, service price/details, staff records) — see
// "No admin audit log for price/status/customer-data changes" in the 30-day
// hardening audit. `changes` stores a small before/after diff as JSON;
// `actor_user_id` is intentionally nullable + SetNull (not Cascade) so
// deleting a user later doesn't erase the historical record that they made
// a change — the log entry just loses its live link back to that account.
model AdminAuditLog {
  id             String  @id @default(uuid())
  actor_user_id  String?
  actor_role     String
  action         String // e.g. "APPOINTMENT_STATUS_UPDATE", "SERVICE_UPDATE", "STAFF_UPDATE"
  entity_type    String // "Appointment" | "Service" | "Staff"
  entity_id      String
  changes        Json // { field: { from, to }, ... }

  created_at DateTime @default(now())

  actor User? @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id])
  @@index([actor_user_id])
  @@index([created_at])
  @@map("admin_audit_logs")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String
  type       String // "booking_update", "status_change", "offer", etc.
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationLog {
  id             String  @id @default(uuid())
  user_id        String
  appointment_id String?

  type   String // "EMAIL" or "SMS"
  event  String // "BOOKING_CONFIRMED", "REMINDER_24H", etc.
  status String @default("PENDING") // PENDING, SENT, FAILED

  recipient     String // email or phone number
  external_id   String? // Resend message ID or Twilio SID
  error_message String?
  sent_at       DateTime?

  created_at DateTime @default(now())

  // Relations
  user        User?        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointment_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([appointment_id])
  @@index([status])
  @@index([created_at])
  @@map("notification_logs")
}

// ====================== ENUMS ======================
enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ServiceCategory {
  EYEBROW_LASH
  WAXING
  FACIAL_SKINCARE
}

enum ChangeRequestType {
  EDIT
  CANCEL
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  DECLINED
}
