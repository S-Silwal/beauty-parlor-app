# Copy this file to .env and fill in the values below.

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Public URL this backend is reachable at — used to build links in emails
# (e.g. unsubscribe) and to verify the QStash webhook signature.
BACKEND_URL=http://localhost:5000

# ====================== DATABASE ======================
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/beauty_parlor?schema=public"

# ====================== AUTH ======================
JWT_SECRET=your_super_long_random_jwt_secret_key_change_this_in_production
REFRESH_SECRET=your_super_long_random_refresh_secret_key

# ====================== EMAIL (Resend) ======================
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Crown & Glow <hello@crownandglow.com>"

# ====================== SMS (Twilio) ======================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ====================== IMAGE UPLOADS (Cloudinary) ======================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ====================== SCHEDULED REMINDERS (Upstash QStash) ======================
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# ====================== DEV SEED DATA (optional overrides) ======================
# `npm run db:seed` falls back to admin123/customer123 if these are unset.
# SEED_ADMIN_EMAIL=admin@lumina.com
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_EMAIL=customer@lumina.com
# SEED_CUSTOMER_PASSWORD=
#
# `db:seed` refuses to run when NODE_ENV=production unless this is set —
# don't set it unless you specifically mean to seed a production database.
# ALLOW_PROD_SEED=true
